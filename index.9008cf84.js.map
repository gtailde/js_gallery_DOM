var galeryList = document.querySelector(".gallery__list");
var listItems = galeryList.querySelectorAll(".list-item");
listItems.forEach(function(item) {
    item.addEventListener("click", function(e) {
        e.preventDefault();
        var clickedEl = e.target;
        var imgSrc;
        if (clickedEl.tagName === "IMG") {
            var link = clickedEl.parentElement;
            imgSrc = link.getAttribute("href");
        } else if (clickedEl.tagName === "A") imgSrc = clickedEl.getAttribute("href");
        if (imgSrc) {
            var largeImg = document.querySelector("#largeImg");
            largeImg.src = new URL(imgSrc, window.location.origin).href;
        }
    });
});

